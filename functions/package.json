{
  "name": "functions",
  "description": "Cloud Functions for Lavaplan",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "fix-duplicate-admins": "npm run build && node lib/scripts/fixDuplicateBuildingAdmins.js",
    "delete-test-account": "npm run build && node lib/scripts/deleteTestAccount.js",
    "set-admin-verified": "npm run build && node lib/scripts/setAdminVerified.js",
    "backfill-building-admins": "npm run build && node lib/scripts/backfillBuildingAdmins.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  },
  "private": true
}
